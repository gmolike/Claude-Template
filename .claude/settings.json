{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Write(apps/**)",
      "Write(packages/**)",
      "Write(docs/**)",
      "Write(.scrum/**)",
      "Write(CHANGELOG.md)",
      "Edit(apps/**)",
      "Edit(packages/**)",
      "Edit(docs/**)",
      "Edit(.scrum/**)",
      "Edit(CHANGELOG.md)",
      "Bash(pnpm *)",
      "Bash(turbo *)",
      "Bash(npx *)",
      "Bash(git *)",
      "Bash(node *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Glob",
      "Grep",
      "Task"
    ],
    "deny": ["Read(.env*)", "Bash(rm -rf /)", "Bash(sudo *)", "Write(.env*)"]
  }
}
