{
  "name": "{{PROJECT_NAME}}-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.4.0",
    "@hono/zod-validator": "^0.4.0",
    "@prisma/client": "^6.1.0",
    "hono": "^4.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.0",
    "tsc-alias": "^1.8.0",
    "typescript": "~5.7.0",
    "vitest": "^2.1.8"
  }
}
